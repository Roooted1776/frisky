.derivedData/

# macOS
.DS_Store
**/.DS_Store

# Never commit key material — even empty placeholders invite real secrets.
uploads/google-api-key
**/google-api-key
*.pem
*.p12
*.mobileprovision

# Xcode — per-user state. Committing these makes every project open replay a
# stale window/editor layout and makes every merge conflict on a binary blob.
xcuserdata/
*.xcuserstate
*.xcuserdatad/
DerivedData/
build/

# Keep shared schemes tracked so Xcode doesn't regenerate them on open:
!*.xcodeproj/xcshareddata/
!*.xcodeproj/xcshareddata/xcschemes/
!*.xcodeproj/xcshareddata/xcschemes/*.xcscheme

# Upload staging artifacts (Cursor/desktop dumps). Keep intentional Swift under uploads/.
uploads/Screenshot*.png
uploads/draw-*.png
uploads/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*

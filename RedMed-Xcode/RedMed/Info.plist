<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>RedMed</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>RedMed</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>RedMed uses Face ID, Touch ID, or your device passcode to unlock editing of your RedMed profile, authorize writing to your bracelet, and open the on-device local history vault. Scanned cards are read-only and cannot be changed without your app and authentication.</string>
	<!-- Required for CoreNFC Write/Scan (passive Type 2 NTAG). -->
	<key>NFCReaderUsageDescription</key>
	<string>RedMed uses NFC so you can write your emergency card to your bracelet and scan it to verify the same HTML tap page helpers open. Passersby who tap the band open that page in a browser — they do not need this app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RedMed uses your location to give 911 your exact GPS coordinates in an emergency.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.redmed.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>redmed</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<!-- Cream only — system splash stays logo-free. Owner lock is watermark + Face ID. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Cream Main chrome is light-only; Dark Mode made system sheets/Help diverge from Xcode/sim. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

# Copy to mcp/.env for local runs (gitignored). Never commit real keys.
# Cursor Cloud / IDE: set the same names as environment secrets.

SUPABASE_URL=https://mohxobgyjkcmkqxijgeg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Hostinger (static Assist + VPS). Falls back to ~/.config/hostinger-mcp/api_token
HOSTINGER_API_TOKEN=REPLACE_ME

# SSH to RedMed KVM (defaults match ~/.ssh/config Host hostinger-vps)
REDMED_VPS_HOST=hostinger-vps
REDMED_VPS_USER=root
REDMED_VPS_IDENTITY=~/.ssh/hostinger_vps
# REDMED_VPS_PORT=22

# ssh (Mini → VPS, default) | local (remote HTTP container on the VPS)
# REDMED_EXEC_MODE=ssh

# Remote Streamable HTTP (VPS only — never commit the real token)
# REDMED_MCP_TOKEN=generate_a_long_random_secret
# REDMED_MCP_PORT=8787
# REDMED_MCP_HOST=0.0.0.0

# RedMed — Hostinger (Apache/LiteSpeed) equivalent of Cloudflare Pages _redirects.
# Translated 1:1 from ../../_redirects. Fragments (#d=) are never sent to the
# server by the browser, so no special handling is needed for them here.

RewriteEngine On

RewriteRule ^$ /tapper/ [R=301,L]
RewriteRule ^index\.html$ /tapper/ [R=301,L]
RewriteRule ^tapper\.html$ /tapper/ [R=301,L]
RewriteRule ^card\.html$ /tapper/ [R=301,L]
RewriteRule ^get\.html$ /tapper/ [R=301,L]
RewriteRule ^redmed-emergency\.html$ /tapper/ [R=301,L]
RewriteRule ^get/?$ /tapper/ [R=301,L]
RewriteRule ^get/index\.html$ /tapper/ [R=301,L]
RewriteRule ^tapper$ /tapper/ [R=301,L]

RewriteRule ^privacy$ /privacy/ [R=301,L]
RewriteRule ^Document$ /Document/ [R=301,L]

RewriteRule ^BrandLogo\.png$ /assets/BrandLogo.png [R=301,L]
RewriteRule ^BrandWordmark\.png$ /assets/BrandWordmark.png [R=301,L]
RewriteRule ^pheart\.png$ /assets/pheart.png [R=301,L]

# --- Headers (root-level files) ---
<IfModule mod_headers.c>
  <FilesMatch "^(tapper\.html|card\.html|index\.html|get\.html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer"
    Header set X-Frame-Options "DENY"
    Header set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; media-src 'self' blob: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src 'self' https://overpass-api.de; manifest-src 'self'; upgrade-insecure-requests"
  </FilesMatch>

  <FilesMatch "^sw\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(BrandLogo\.png|BrandWordmark\.png|pheart\.png)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"
  </FilesMatch>

  <FilesMatch "^apple-app-site-association$">
    Header set Content-Type "application/json"
  </FilesMatch>
</IfModule>

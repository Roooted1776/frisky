/*
  Cloudflare Pages — almost-instant tap-to-view + security headers.
  Shell + logo may use short TTL + stale-while-revalidate so a prior open
  paints from browser disk cache without waiting on origin. SW file always
  revalidates so CACHE bumps take effect. Service Worker Cache Storage is the
  primary offline path (see tapper/sw.js redmed-tapper-vN).

  Security: apply to every Pages response. CSP allows unsafe-inline because
  tapper.html ships decrypt + locale scripts inline (no build-time nonces).
  frame-ancestors / X-Frame-Options block clickjacking of the medical card.
  Payload stays in #d= only — never in HTTP cache keys.
*/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src 'self'; manifest-src 'self'
*/
/tapper/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/tapper/BrandLogo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/BrandLogo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/BrandLogo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/tapper
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/tapper/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/tapper/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/tapper.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/card.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/tapper/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Cloudflare Pages — cache + security headers for the passerby card.
# Comments are `#` only. `/*` is the all-paths URL pattern (not a block comment).
# Shell + logo may use short TTL + stale-while-revalidate. SW always revalidates
# so CACHE bumps take effect. Payload stays in #d= only — never in HTTP cache keys.
# CSP allows unsafe-inline because get.html ships decrypt + locale scripts inline.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src 'self'; manifest-src 'self'

/get/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/get/BrandLogo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/BrandLogo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/BrandLogo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/get
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/card.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/get/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

// Cloudflare Workers — RedMed passerby emergency shell (static assets + device hint).
// Production Worker: redmed-emergency (dashboard Settings → Domains & Routes / Observability).
// build.command stages public shell → dist/passerby before deploy / versions upload
// Worker injects data-device from UA / CF-Device-Type; client refines with viewport aspect.
// NOT the band write base and not used for the product shell (docs/domain.md):
// bands point at https://redmed.live/tapper/ (Hostinger). workers.dev /tapper/ 404s.
{
  "name": "redmed-emergency",
  "main": "worker/index.js",
  "account_id": "a2d8a74738a0280eb9d5a3e77acd59ea",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "bash scripts/stage-worker-assets.sh"
  },
  "assets": {
    "directory": "./dist/passerby",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/tapper",
      "/tapper/",
      "/tapper/index.html",
      "/card.html",
      "/get.html",
      "/get",
      "/get/"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
